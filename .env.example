# polling работает без домена; webhook требует PUBLIC_BASE_URL и секреты ниже.
UPDATE_MODE=polling
# PUBLIC_BASE_URL=https://bot.example.ru
# DOMAIN=bot.example.ru

# Telegram-бот с включённым Business Mode в @BotFather.
TELEGRAM_BOT_TOKEN=123456789:replace_me
# TELEGRAM_WEBHOOK_SECRET=replace_with_random_letters_digits_dash_or_underscore

# Бот MAX, прошедший модерацию на платформе MAX для партнёров.
MAX_BOT_TOKEN=replace_me
MAX_OPERATOR_USER_ID=123456789
# MAX_WEBHOOK_SECRET=replace_with_random_letters_digits_dash_or_underscore

# Если системное хранилище сервера не доверяет сертификату API MAX,
# смонтируйте сертификат Минцифры и укажите путь внутри контейнера.
# MAX_CA_FILE=/app/certs/russian_trusted_root_ca.pem

DATABASE_PATH=data/bridge.db
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=30
POLLING_TIMEOUT_SECONDS=50
POLLING_DROP_PENDING_UPDATES=false
MAX_DOWNLOAD_BYTES=20971520
SEND_CONFIRMATIONS=true
